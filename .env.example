# Copy to .env.local and fill in. Never commit real values.

# The NestJS backend (api/). It mints the session token this app stores as its cookie.
NEST_API_URL=http://localhost:3001

# Signs and verifies the session cookie. Must match api/'s SESSION_SECRET exactly (same JWT, two
# processes). At least 32 characters: `openssl rand -base64 32`
SESSION_SECRET=
